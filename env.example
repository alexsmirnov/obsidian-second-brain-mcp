# OpenAI-compatible model router base URL. Required for any AI feature
# (web research and Obsidian RAG embeddings/inference). Leave empty to
# disable all router-backed tools.
ROUTER_API_BASE=http://localhost:4000

# Authentication token for the model router above.
ROUTER_API_KEY=sk-router-token

# Embedding model name served by the router. Used to index and query
# Obsidian vault chunks. Empty disables vault indexing/search.
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Vector dimension for the embedding model above. Must match the model's
# output size or LanceDB schema creation will fail.
RAG_EMBEDDING_DIMENSIONS=1536

# Optional reranker model served by the router. When set, LanceDB uses it
# for DB-level reranking. Empty falls back to local RRF/LlmReranker logic.
RAG_RERANKER_MODEL=gpt-4o-mini

# Optional chat model for search-level HyDE generation and structured
# reranking. Empty keeps vault search vector-only.
RAG_INFER_MODEL=

# Optional chat model used by the local LLM reranker when no proxy
# reranker is configured. Empty disables LLM-based reranking.
RAG_RERANKER_INFER_MODEL=gemini-flash-lite

# Optional embedding model used by the local LLM reranker. Empty reuses
# RAG_EMBEDDING_MODEL.
RAG_RERANKER_EMBEDDING_MODEL=

# Vector dimension for RAG_RERANKER_EMBEDDING_MODEL above. Ignored when
# that model is empty.
RAG_RERANKER_EMBEDDING_DIMENSIONS=768

# Fast/cheap chat model for web research query generation and result
# cleanup. Empty disables web research.
RESEARCH_FAST_MODEL=gemini-flash-lite

# Stronger chat model for web research reflection and final answer
# synthesis. Empty disables web research.
RESEARCH_INFER_MODEL=gemini-flash

# Optional Anthropic API key for non-RAG integrations.
ANTHROPIC_API_KEY=sk-ant-...

# Google Custom Search API key. Required only when using Google instead of
# DuckDuckGo for web research.
GOOGLE_API_KEY=

# Google Custom Search Engine ID. Required only when GOOGLE_API_KEY is set.
GOOGLE_SEARCH_ID=

# Web fetch: generic pages are rendered through crawl4ai over a CDP browser.
# The server never starts a browser itself. When BROWSER_CDP_URL is unset or
# unreachable at startup, only the web_research tool is disabled.
# CDP endpoint of a running browser. Must be unauthenticated (e.g.
# ws://127.0.0.1:9222).
BROWSER_CDP_URL=
# Pages render in the tabs of a pool of named browser sessions; each tab goes
# back to about:blank after its fetch. Defaults are shown; unset uses them.
# Tabs of the pool (also the cap on parallel renders; replaces FETCH_CONCURRENCY).
# BROWSER_POOL_SIZE=2
# When the browser connection is lost the server reconnects on its own:
# attempts to start a new connection, with a pause before each one.
# BROWSER_RECONNECT_ATTEMPTS=5
# BROWSER_RECONNECT_DELAY_SECONDS=2.0
# Time limit for one connection attempt.
# BROWSER_CONNECT_TIMEOUT_SECONDS=30.0
# Extra tries of a fetch whose connection was lost (other failures are not retried).
# BROWSER_FETCH_RETRIES=1
# Time limit for resetting a tab or closing a connection.
# BROWSER_CLEANUP_TIMEOUT_SECONDS=5.0
# docker compose only (read by docker-compose.yaml, not by the server):
# memory ceiling (no swap) and shared memory of the browser container.
# BROWSER_MEMORY_LIMIT=1g
# BROWSER_SHM_SIZE=256m
# Obscura time budgets in milliseconds.
# OBSCURA_NAV_TIMEOUT_MS=15000
# OBSCURA_SCRIPT_DEADLINE_MS=8000
# OBSCURA_MODULE_BUDGET_MS=1500
# OBSCURA_CDP_COMMAND_TIMEOUT_MS=20000
# web_research runs as a background job. The call waits this many seconds
# for the answer, then returns a job name to read with web_research_status.
# Keep it below the MCP client timeout (30 s by default).
RESEARCH_WAIT_SECONDS=
# Finished research jobs are forgotten this many seconds after their last update.
RESEARCH_JOB_TTL_SECONDS=
# Commercial unblocking provider for blocked (401/403/429), empty, timeout,
# or browser-unavailable pages: scrape_do, bright_data, or empty (disabled).
SCRAPER_PROVIDER=
# Scrape.do API token. Required when SCRAPER_PROVIDER=scrape_do.
SCRAPE_DO_TOKEN=
# Bright Data API key and Web Unlocker zone. Required when SCRAPER_PROVIDER=bright_data.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=
# Router decision model (e.g. jev-latest) for per-fragment relevance through
# POST /v1/systemone. Requires a valid router URL. Empty keeps local lexical
# filtering.
DECISION_MODEL=
# Comma-separated hostnames (and their subdomains) that fetch must never visit.
FETCH_RESTRICTED_DOMAINS=

# Minimum reranker relevance score for a vault search result to be kept.
# RRF reranking scores are ~0.016, LLM/proxy rerankers score 0..1, so the
# default 0.0 keeps all results.
MIN_SCORE=0.0

# Absolute path to the Obsidian vault root. Empty disables vault tools.
VAULT=/Users/username/Documents/ObsidianVault
